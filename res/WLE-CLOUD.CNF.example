# Launchstation native Google Drive configuration (OPTIONAL)
#
# Official builds already include Launchstation's own Google client, so this
# file is NOT needed to link Google Drive. Use it only to substitute your own
# OAuth client of type "TVs and Limited Input devices" from a Google Cloud
# project with the Google Drive API enabled.
#
# This file belongs beside DASHBOARD.CNF. Do not put refresh/access tokens
# here; Launchstation stores the user's refresh token separately in WLE-CLOUD.TOK.
# Both values are required: Google's device flow needs the client secret.
Google_Client_ID =
Google_Client_Secret =
