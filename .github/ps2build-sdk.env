# The ps2build SDK CI builds with: the newest official release of each component.
# The SDK script resolves the versions from git.techwritescode.dev at the start of each job and installs
# them (cache, then the official server, then the newest NathanNeurotic/ps2build-mirror release when that
# host fails). CI caches the SDK under the resolved versions, so a new upstream release is picked up by
# the next build.
#
# A bare name follows the newest release. To hold a component back (a broken upstream release), write
# name=version, e.g. sdk-core=v2026.10.13.1 or PS2BUILD_LLVM_TOOLCHAIN=v0.3.8.
PS2BUILD_SDK_MIRROR=NathanNeurotic/ps2build-mirror
PS2BUILD_COMPONENTS="cmake ninja ps2build sdk-core sdk-world toolchain tools vcl"
PS2BUILD_LLVM_TOOLCHAIN=latest
